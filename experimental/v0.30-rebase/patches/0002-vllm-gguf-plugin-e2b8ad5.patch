+    rows_per_expert = torch.zeros((E,), dtype=torch.int32, device=x.device)
+    unpermuted = torch.empty((num_tokens, top_k), dtype=torch.int32, device=x.device)
+    torch.ops._moe_C.remap_hidden_states(
